{
  "id": "water-imbalance-wmo",
  "name": "Water Imbalance - WMO Basins",
  "version": "0.1.1",
  "assetVersion": "2026-06-17-boundary-defaults",
  "description": "Basin-scale three-variable water imbalance classification, time series, and literature evidence for GRDC WMO Basin/Sub-Basin.",
  "author": "Spatial Research Team",
  "icon": "droplet",
  "entry": "../water-imbalance/index.js",
  "className": "WaterImbalanceModule",
  "importKind": "module-manifest",
  "defaultLoad": true,
  "layerId": "water-imbalance-wmo-basins",
  "layerName": "WMO Basin Water Imbalance",
  "knowledgeGraph": "./data/runtime-graph.json",
  "datasets": [
    {
      "id": "basin-three-variable-timeseries-1962-2016",
      "metadata": "./data/basin-time-series-metadata.json"
    }
  ],
  "provides": {
    "layers": [
      {
        "id": "water-imbalance-wmo-basins",
        "name": "WMO Basin Water Imbalance",
        "type": "vector",
        "source": "module.basins",
        "interactive": true
      }
    ],
    "panels": [
      {
        "id": "water-imbalance-wmo-inspector",
        "name": "Water Imbalance - WMO Basins Inspector",
        "position": "right",
        "trigger": "feature:click",
        "condition": {
          "layer": "water-imbalance-wmo-basins",
          "module": "water-imbalance-wmo"
        }
      },
      {
        "id": "water-imbalance-wmo-literature-evidence",
        "name": "Literature Evidence",
        "position": "right",
        "tab": true
      }
    ],
    "dataProducts": [
      {
        "id": "basin-imbalance-classification",
        "type": "derived-classification",
        "description": "Classifies each basin from recent-versus-historical shifts in water-demand deficit, groundwater storage, and glacier storage."
      },
      {
        "id": "basin-hydrology-time-series",
        "type": "basin-time-series",
        "description": "Three annual hydrological variables joined to GRDC WMO Basin/Sub-Basin by basin_id."
      },
      {
        "id": "literature-evidence",
        "type": "literature-catalog",
        "description": "Literature records retained independently from the numerical imbalance classification."
      }
    ]
  }
}
