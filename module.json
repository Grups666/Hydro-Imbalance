{
  "id": "water-imbalance",
  "name": "Water Imbalance - Major River Basins",
  "version": "0.1.1",
  "assetVersion": "2026-06-19-literature-validation",
  "description": "Basin-scale three-variable water imbalance classification, time series, and basin ontology for GRDC Major River Basins.",
  "author": "Spatial Research Team",
  "icon": "droplet",
  "basePath": "https://grups666.github.io/Hydro-Imbalance/",
  "entry": "./public/modules/water-imbalance/index.js",
  "className": "WaterImbalanceModule",
  "importKind": "module-manifest",
  "defaultLoad": false,
  "layerId": "water-imbalance-mrb-basins",
  "layerName": "Major River Basin Water Imbalance",
  "datasets": [
    {
      "id": "basin-three-variable-timeseries-1962-2016",
      "metadata": "./public/modules/water-imbalance/data/basin-time-series-metadata.json"
    }
  ],
  "provides": {
    "layers": [
      {
        "id": "water-imbalance-mrb-basins",
        "name": "Major River Basin Water Imbalance",
        "type": "vector",
        "source": "module.basins",
        "interactive": true
      }
    ],
    "panels": [
      {
        "id": "water-imbalance-inspector",
        "name": "Water Imbalance - Major River Basins Inspector",
        "position": "right",
        "trigger": "feature:click",
        "condition": {
          "layer": "water-imbalance-mrb-basins",
          "module": "water-imbalance"
        }
      }
    ],
    "dataProducts": [
      {
        "id": "basin-imbalance-classification",
        "type": "derived-classification",
        "description": "Classifies each basin from recent-versus-historical shifts in water-demand deficit, groundwater storage, and glacier storage."
      },
      {
        "id": "basin-hydrology-time-series",
        "type": "basin-time-series",
        "description": "Three annual hydrological variables joined to GRDC Major River Basins by basin_id."
      },
      {
        "id": "basin-literature-evidence",
        "type": "literature-evidence",
        "description": "Curated literature benchmarks attached to basin ontology IDs and variable keys for order-of-magnitude validation."
      }
    ]
  }
